#, c-format
msgid "%s: Orphaned variable index record (type 4).  Type 4 records must always immediately follow type 3 records"
msgstr "%s: Osierocony rekord (typ 4) indeksu zmiennej. Rekordy typu 4 muszą zawsze następować po rekordach typu 3"

#: sfm-read.c:448
#, c-format
msgid "%s: Very long string record(s) found (record type 7, subtype %d), each will be imported in consecutive separate variables"
msgstr "%s: Znaleziono bardzo długie teksty (typ rekordu 7, podtyp %d), każdy tekst będzie zaimportowany w kolejnych oddzielnych zmiennych"

#: sfm-read.c:473
#, c-format
msgid "%s: Long string value labels record found (record type 7, subtype %d), but ignored"
msgstr "%s: Znaleziono wpis z długą nazwą (typ rekordu 7, podtyp %d), ale zignorowano"

#: sfm-read.c:478
#, c-format
msgid "%s: Long string missing values record found (record type 7, subtype %d), but ignored"
msgstr "%s: Znaleziono wpis z brakującym tekstem (typ rekordu 7, podtyp %d), ale zignorowano"

#: sfm-read.c:487
#, c-format
msgid "%s: Unrecognized record type 7, subtype %d encountered in system file"
msgstr "%s: Nierozpoznany typ 7 rekordu, podtyp %d napotkany w pliku systemowym"

#: sfm-read.c:510
#, c-format
msgid "%s: Unrecognized record type %d"
msgstr "%s: Nierozpoznany typ %d rekordu"

#: sfm-read.c:518
msgid "Read system-file dictionary successfully"
msgstr "Poprawnie odczytano słownik pliku systemowego"

#: sfm-read.c:534
msgid "error reading system-file header"
msgstr "błąd podczas odczytywania nagłówka pliku systemowego"

#: sfm-read.c:549
#, c-format
msgid "%s: Bad size (%d) or count (%u) field on record type 7, subtype 3.\tExpected size %ld, count 8"
msgstr "%s: Niepoprawne pole rozmiaru (%d) lub zliczenia (%u) na rekordzie typu 7, podtyp 3. Oczekiwano rozmiaru %ld oraz 8 zliczeń"

#: sfm-read.c:562
#, c-format
msgid "%s: Floating-point representation in system file is not IEEE-754.  read.spss cannot convert between floating-point formats"
msgstr "%s: Reprezentacja zmiennoprzecinkowa w pliku systemowym nie jest w standardzie IEEE-754. read.spss nie może wykonywać konwersji pomiędzy formatami zmiennoprzecinkowymi"

#: sfm-read.c:581
#, c-format
msgid "%s: File-indicated endianness (%s) does not match endianness intuited from file header (%s)"
msgstr "%s: Wskazana przez plik kolejność bajtów (%s) nie zgadza się z kolejnością bajtów wywnioskowanych z nagłówka pliku (%s)"

#: sfm-read.c:593
#, c-format
msgid "%s: File-indicated character representation code (%s) is not ASCII"
msgstr "%s: Wskazany przez plik kod reprezentacji znaków (%s) nie jest kodem ASCII"

#: sfm-read.c:598
#, c-format
msgid "%s: File-indicated character representation code (%d) is unknown"
msgstr "%s: Wskazany przez plik kod reprezentacji znaków (%d) jest nieznany"

#: sfm-read.c:615
#, c-format
msgid "%s: Bad size (%d) or count (%u) field on record type 7, subtype 4.\tExpected size %lu, count 8"
msgstr "%s: Niepoprawne pole rozmiaru (%d) lub zliczenia (%u) na rekordzie typu 7, podtyp 4. Oczekiwano rozmiaru %lu oraz 8 zliczeń"

#: sfm-read.c:629
#, c-format
msgid "%s: File-indicated value is different from internal value for at least one of the three system values.  SYSMIS: indicated %g, expected %g; HIGHEST: %g, %g; LOWEST: %g, %g"
msgstr "%s: Wskazana przez plik wartość jest różna od wartości wewnętrznej dla przynajmniej jeden z trzech wartości systemowych.  SYSMIS: wskazał %g, oczekiwano %g; NAJWYŻSZA: %g, %g; NAJNIŻSZA: %g, %g"

#: sfm-read.c:654
#, c-format
msgid "%s: strange record info seen, size=%lu, count=%u, ignoring long variable names"
msgstr "%s: dziwny wpis informacyjny, rozmiar=%lu, zliczenia=%u, ignorowanie długich nazw zmiennych"

#: sfm-read.c:681
#, c-format
msgid "%s: long variable name mapping '%s' to '%s' for variable which does not exist"
msgstr "%s: mapowanie długiej nazwy zmiennej '%s' na '%s' dla zmiennej która nie istnieje"

#: sfm-read.c:735
#, c-format
msgid "%s: Bad magic. Proper system files begin with the four characters '$FL2'. This file will not be read"
msgstr "%s: Niepoprawna liczba magiczna. Poprawne pliki systemowe rozpoczynają się czterema znakami'$FL2'. Ten plik nie będzie odczytywany"

#: sfm-read.c:777
#, c-format
msgid "%s: File layout code has unexpected value %d.  Value should be 2 or 3, in big-endian or little-endian format"
msgstr "%s: Kod układu pliku ma nieoczekiwaną wartość %d.  Wartość powinna wynosić 2 lub 3, w formacie grubokońcowości lub cienkokońcowości"

#: sfm-read.c:792
#, c-format
msgid "%s: Number of elements per case (%d) is not between 1 and %ld"
msgstr "%s: Liczba elementów na przypadek (%d) nie jest pomiędzy 1 a %ld"

#: sfm-read.c:800
#, c-format
msgid "%s: Index of weighting variable (%d) is not between 0 and number of elements per case (%d)"
msgstr "%s: Indeks zmiennej ważącej (%d) nie jest pomiędzy 0 a liczbą elementów na przypadek (%d)"

#: sfm-read.c:805
#, c-format
msgid "%s: Number of cases in file (%d) is not between -1 and %d"
msgstr "%s: Liczba przypadków w pliku (%d) nie jest pomiędzy -1 a %d"

#: sfm-read.c:810
#, c-format
msgid "%s: Compression bias (%g) is not the usual value of 100"
msgstr "%s: Obciążenie kompresji (%g) nie jest typową wartością 100"

#: sfm-read.c:910
#, c-format
msgid "%s: position %d: Bad record type (%d); the expected value was 2"
msgstr "%s: pozycja %d: Niepoprawny typ (%d) rekordu; oczekiwano wartości 2"

#: sfm-read.c:919
#, c-format
msgid "%s: position %d: String variable does not have proper number of continuation records"
msgstr "%s: pozycja %d: Zmienna tekstowa nie ma poprawnej liczby kontynuujących rekordów"

#: sfm-read.c:927
#, c-format
msgid "%s: position %d: Superfluous long string continuation record"
msgstr "%s: pozycja %d: Zbędny długotekstowy rekord kontynuacyjny"

#: sfm-read.c:932
#, c-format
msgid "%s: position %d: Bad variable type code %d"
msgstr "%s: pozycja %d: Niepoprawny kod %d typu zmiennej"

#: sfm-read.c:935
#, c-format
msgid "%s: position %d: Variable label indicator field is not 0 or 1"
msgstr "%s: pozycja %d: Pole wskazujące etykietę zmiennej nie ma wartości 0 lub 1"

#: sfm-read.c:939
#, c-format
msgid "%s: position %d: Missing value indicator field is not -3, -2, 0, 1, 2, or 3"
msgstr "%s: pozycja %d: Pole wskazujące brakujące wartości nie ma wartości -3, -2, 0, 1, 2, lub 3"

#: sfm-read.c:961
#, c-format
msgid "%s: position %d: Variable name begins with octothorpe ('#').  Scratch variables should not appear in system files"
msgstr "%s: pozycja %d: Nazwa zmiennej rozpoczyna się znakiem hash ('#').  Usunięte zmienne nie powinny pojawiać się w plikach systemowych"

#: sfm-read.c:983
#, c-format
msgid "%s: position %d: character '\\%03o' (%c) is not valid in a variable name"
msgstr "%s: pozycja %d: znak '\\%03o' (%c) nie jest poprawny w nazwie zmiennej"

#: sfm-read.c:1025
#, c-format
msgid "%s: Variable %s indicates variable label of invalid length %d"
msgstr "%s: Zmienna %s wskazuje na etykietę zmiennej o niepoprawnej długości %d"

#: sfm-read.c:1041
#, c-format
msgid "%s: Long string variable %s may not have missing values"
msgstr "%s: Długotekstowa zmienna %s nie może mieć wartości brakujących"

#: sfm-read.c:1064
#, c-format
msgid "%s: String variable %s may not have missing values specified as a range"
msgstr "%s: Tekstowa zmienna %s nie może wartości brakujących określonych jako zakres"

#: sfm-read.c:1107
#, c-format
msgid "%s: Long string continuation records omitted at end of dictionary"
msgstr "%s: Długotekstowe rekordy kontynuacyjne pominięte na końcu słownika"

#: sfm-read.c:1110
#, c-format
msgid "%s: System file header indicates %d variable positions but %d were read from file"
msgstr "%s: Nagłówek pliku systemowego wskazuje na %d pozycje zmiennych, ale %d zostało odczytanych z pliku"

#: sfm-read.c:1119
#, c-format
msgid "%s: Duplicate variable name '%s' within system file"
msgstr "%s: Powtórzona nazwa '%s' zmiennej wewnątrz pliku systemowego"

#: sfm-read.c:1158
#, c-format
msgid "%s: %s variable %s has %s format specifier %s"
msgstr "%s: Zmienna %s %s posiada określający format %s %s"

#: sfm-read.c:1236
#, c-format
msgid "%s: Variable index record (type 4) does not immediately follow value label record (type 3) as it ought"
msgstr "%s: Indeks rekordu (typ 4) zmiennej nie następuje od razu po indeksie rekordu (typ 3) zmiennej jak powinien"

#: sfm-read.c:1245
#, c-format
msgid "%s: Number of variables associated with a value label (%d) is not between 1 and the number of variables (%d)"
msgstr "%s: Liczba zmiennych powiązanych z wartością etykiety (%d) nie jest pomiędzy 1 a liczbą zmiennych (%d)"

#: sfm-read.c:1262
#, c-format
msgid "%s: Variable index associated with value label (%d) is not between 1 and the number of values (%d)"
msgstr "%s: Indeks zmiennej powiązany z wartością etykiety (%d) nie jest pomiędzy 1 a liczbą wartości (%d)"

#: sfm-read.c:1268
#, c-format
msgid "%s: Variable index associated with value label (%d) refers to a continuation of a string variable, not to an actual variable"
msgstr "%s: Indeks zmiennej powiązany z wartością etykiety (%d) odnosi się do kontynuacji zmiennej tekstowej, nie do aktualnej zmiennej"

#: sfm-read.c:1271
#, c-format
msgid "%s: Value labels are not allowed on long string variables (%s)"
msgstr "%s: Etykiety wartości nie są dozwolone dla długotekstowych zmiennych (%s)"

#: sfm-read.c:1280
#, c-format
msgid "%s: Variables associated with value label are not all of identical type.  Variable %s has %s type, but variable %s has %s type"
msgstr "%s: Zmienne powiązane z etykietami wartości nie mają identycznego typu.  Zmienna %s posiada typ %s, ale zmienna %s posiada typ %s"

#: sfm-read.c:1322
#, c-format
msgid "%s: File contains duplicate label for value %g for variable %s"
msgstr "%s: Plik zawiera powtórzone etykiety dla wartości %g zmiennej %s"

#: sfm-read.c:1325
#, c-format
msgid "%s: File contains duplicate label for value '%.*s' for variable %s"
msgstr "%s: Plik zawiera powtórzone etykiety dla wartości '%.*s' zmiennej %s"

#: sfm-read.c:1364 sfm-read.c:1637
#, c-format
msgid "%s: Reading system file: %s"
msgstr "%s: Czytanie pliku systemowego: %s"

#: sfm-read.c:1366 sfm-read.c:1546 sfm-read.c:1587
#, c-format
msgid "%s: Unexpected end of file"
msgstr "%s: Nieoczekiwany koniec pliku"

#: sfm-read.c:1382
#, c-format
msgid "%s: System file contains multiple type 6 (document) records"
msgstr "%s: Plik systemowy zawiera wielokrotne rekordy typu 6 (dokument)"

#: sfm-read.c:1392
#, c-format
msgid "%s: Number of document lines (%d) must be greater than 0"
msgstr "%s: Liczba linii (%d) dokumentu musi być większa niż 0"

#: sfm-read.c:1501
#, c-format
msgid "%s: Error reading file: %s"
msgstr "%s: Błąd podczas czytania pliku: %s"

#: sfm-read.c:1538
#, c-format
msgid "%s: Compressed data is corrupted.  Data ends partway through a case"
msgstr "%s: Skompresowane dane są uszkodzone.  Dane kończą się częściowo na przypadku"

#: sfm-read.c:1639
#, c-format
msgid "%s: Partial record at end of system file"
msgstr "%s: Częściowy rekord na końcu pliku systemowego"

#: spss.c:383 spss.c:505
msgid "nval is 0"
msgstr "'nval' jest równe 0"

#: spss.c:674
#, c-format
msgid "problem in reading file '%s'"
msgstr "problem podczas czytania pliku '%s'"

#: spss.c:684
#, c-format
msgid "file '%s' is not in any supported SPSS format"
msgstr "plik '%s' nie jest w żadnym wspieranym formacie SPSS"

#: stataread.c:96 stataread.c:106 stataread.c:114 stataread.c:141
#: stataread.c:154 stataread.c:164 stataread.c:521
msgid "a binary read error occurred"
msgstr "wystąpił błąd odczytu binarnego"

#: stataread.c:242
msgid "not a Stata version 5-12 .dta file"
msgstr "to nie jest plik .dta Stata wersja 5-12"

#: stataread.c:440
msgid ""
"something strange in the file\n"
" (Type 0 characteristic of nonzero length)"
msgstr ""
"coś dziwnego w pliku\n"
" (Charakterystyka typu 0 posiada niezerową długość)"

#: stataread.c:467 stataread.c:499
msgid "invalid character string length -- truncating to 244 bytes"
msgstr "niepoprawna długość ciągu znaków -- obcinanie do 244 bajtów"

#: stataread.c:585
msgid "can not yet read Stata .dta on this platform"
msgstr "nie można na chwilę obecną odczytać pliku .dta Stata na tej platformie"

#: stataread.c:589 stataread.c:1045
msgid "first argument must be a file name\n"
msgstr "pierwszy argument musi być nazwą pliku\n"

#: stataread.c:607 stataread.c:614 stataread.c:620 stataread.c:635
#: stataread.c:637 stataread.c:645 stataread.c:653
msgid "a binary write error occurred"
msgstr "nastąpił błąd zapisu danych binarnych"

#: stataread.c:723
msgid "this should happen: overrun"
msgstr "to nie powinno się zdarzyć: przeskakiwanie"

#: stataread.c:725
msgid "this should happen: underrun"
msgstr "to nie powinno się zdarzyć: przepuszczanie"

#: stataread.c:811 stataread.c:841
#, c-format
msgid "character strings of >244 bytes in column %d will be truncated"
msgstr "ciągi znaków większe niż 244 bajty w kolumnie %d zostaną przycięte"

#: stataread.c:978
msgid "empty string is not valid in Stata's documented format"
msgstr "pusty ciąg znaków nie jest poprawny w udokumentowanym formacie Stata"

#: stataread.c:984
msgid "this should not happen."
msgstr "to nie powinno się zdarzyć."

#: stataread.c:1041
msgid "cannot yet read write .dta on this platform"
msgstr "nie można na chwilę obecną zapisać pliku .dta Stata na tej platformie"

#: stataread.c:1049
msgid "data to be saved must be in a data frame"
msgstr "zapisywane dane muszą być w formacie ramki danych"

#: stataread.c:1052
#, c-format
msgid "unable to open file for writing: '%s'"
msgstr "nie można otworzyć pliku do zapisu: '%s'"

#: stataread.c:1057
msgid "can only write version 6-10 formats"
msgstr "można zapisywać formaty w wersji 6-10"

